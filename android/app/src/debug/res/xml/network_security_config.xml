<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: plain HTTP to the mock server on this machine
     (adb reverse to 127.0.0.1, or 10.0.2.2 from the emulator), so ExoPlayer
     can stream voicemail from it. Everything else stays HTTPS-only, and
     release builds have no such file. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>